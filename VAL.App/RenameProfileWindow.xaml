<Window x:Class="VAL.App.RenameProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Переименование профиля"
        SizeToContent="Height"
        Width="440"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#17191D"
        Foreground="#D6D8D9"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        FocusManager.FocusedElement="{Binding ElementName=ProfileNameBox}">

    <Window.Resources>

        <SolidColorBrush x:Key="BgBrush"           Color="#17191D"/>
        <SolidColorBrush x:Key="PanelBrush"        Color="#22262C"/>
        <SolidColorBrush x:Key="ElevatedBrush"     Color="#30363E"/>
        <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#2E343C"/>
        <SolidColorBrush x:Key="LineBrush"         Color="#41464D"/>
        <SolidColorBrush x:Key="TextBrush"         Color="#D6D8D9"/>
        <SolidColorBrush x:Key="MutedBrush"        Color="#9299A2"/>
        <SolidColorBrush x:Key="DimBrush"          Color="#747D87"/>
        <SolidColorBrush x:Key="AccentBrush"       Color="#D58A36"/>
        <SolidColorBrush x:Key="AccentHoverBrush"  Color="#F0A34C"/>
        <SolidColorBrush x:Key="AccentSoftBrush"   Color="#3A3027"/>
        <SolidColorBrush x:Key="CardBrush"         Color="#2A3037"/>

        <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

        <Style x:Key="VALButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ElevatedBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PanelBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Главная кнопка; неактивна при пустом названии -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource VALButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource BgBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B87429"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#B87429"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, ElementName=ProfileNameBox}" Value="">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Поле ввода -->
        <Style x:Key="ProfileNameBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="12,0"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"/>
                                <TextBlock x:Name="Hint"
                                           Text="Введите новое название"
                                           Foreground="{StaticResource DimBrush}"
                                           VerticalAlignment="Center"
                                           Margin="12,0"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource MutedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Название в живом предпросмотре: пока поле пустое, показывает заглушку -->
        <Style x:Key="PreviewNameStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="{Binding Text, ElementName=ProfileNameBox}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, ElementName=ProfileNameBox}" Value="">
                    <Setter Property="Text" Value="Без названия"/>
                    <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
                    <Setter Property="FontStyle" Value="Italic"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Orientation="Horizontal">
            <Border Width="3" Height="38"
                    Background="{StaticResource AccentBrush}"
                    CornerRadius="2"
                    Margin="0,0,12,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Переименование"
                           FontSize="19"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="Список модов в профиле не изменится"
                           FontSize="12"
                           Foreground="{StaticResource DimBrush}"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Поле и счётчик символов -->
        <Grid Grid.Row="1" Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Новое название профиля"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="12"
                       FontWeight="SemiBold"/>

            <TextBlock Grid.Column="1"
                       Foreground="{StaticResource DimBrush}"
                       FontSize="12">
                <Run Text="{Binding Text.Length, ElementName=ProfileNameBox, Mode=OneWay}"/><Run Text=" / 40"/>
            </TextBlock>
        </Grid>

        <TextBox x:Name="ProfileNameBox"
                 Grid.Row="2"
                 Style="{StaticResource ProfileNameBoxStyle}"
                 Margin="0,7,0,0"
                 Height="38"
                 MaxLength="40"
                 VerticalContentAlignment="Center"/>

        <!-- Живой предпросмотр -->
        <StackPanel Grid.Row="3" Margin="0,18,0,0" VerticalAlignment="Top">
            <TextBlock Text="Так профиль будет выглядеть в списке"
                       Foreground="{StaticResource DimBrush}"
                       FontSize="12"
                       Margin="0,0,0,7"/>

            <Border Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="34" Height="34"
                            Background="{StaticResource AccentSoftBrush}"
                            CornerRadius="8"
                            Margin="0,0,12,0">
                        <TextBlock Text="&#xE77B;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="16"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Grid.Column="1"
                               Style="{StaticResource PreviewNameStyle}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,24,0,0">

            <Button Content="Отмена"
                    Style="{StaticResource VALButtonStyle}"
                    Width="100"
                    Margin="0,0,10,0"
                    IsCancel="True"/>

            <Button Content="Сохранить"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="120"
                    IsDefault="True"
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
