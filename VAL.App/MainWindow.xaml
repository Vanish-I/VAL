<Window x:Class="VAL.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VAL Launcher"
        Height="650" Width="1000"
        MinHeight="450" MinWidth="700"
        Background="#17191F"
        Foreground="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="VAL | Vanilla Authentic Life"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <!-- Верхняя панель -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Кнопки слева -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal">
                <Button Content="Выбрать игру"
                        Click="SelectGame_Click"
                        Margin="0,0,10,0"
                        Padding="15,8"/>

                <Button Content="Сканировать моды"
                        Click="ScanMods_Click"
                        Padding="15,8"/>
            </StackPanel>

            <!-- Поиск и фильтр справа -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <TextBox x:Name="SearchBox"
                         Width="230"
                         Height="32"
                         Margin="0,0,10,0"
                         Padding="7,5"
                         VerticalContentAlignment="Center"
                         Background="#303641"
                         Foreground="White"
                         BorderBrush="#505866"
                         CaretBrush="White"
                         TextChanged="SearchBox_TextChanged"
                         ToolTip="Поиск по названию или PackageId">

                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="5">
                                            <Grid>
                                                <ScrollViewer x:Name="PART_ContentHost"
                                                              Margin="7,0"/>

                                                <TextBlock Text="Поиск модов..."
                                                           Foreground="#9099A8"
                                                           Margin="8,0"
                                                           VerticalAlignment="Center"
                                                           IsHitTestVisible="False">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource AncestorType=TextBox}}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <ComboBox x:Name="SourceFilter"
                          Width="140"
                          Height="32"
                          SelectedIndex="0"
                          SelectionChanged="SourceFilter_SelectionChanged">
                    <ComboBoxItem Content="Все моды"/>
                    <ComboBoxItem Content="Workshop"/>
                    <ComboBoxItem Content="Local"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- Таблица модов -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Список модов -->

            <!-- Список модов -->
            <DataGrid Grid.Column="0"
          x:Name="ModsGrid"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          Background="#22252D"
          Foreground="White"
          RowBackground="#22252D"
          AlternatingRowBackground="#2B303A"
          GridLinesVisibility="Horizontal"
          HorizontalGridLinesBrush="#414653"
          HeadersVisibility="Column"
          CanUserAddRows="False"
          SelectionChanged="ModsGrid_SelectionChanged"
          PreviewMouseRightButtonDown="ModsGrid_PreviewMouseRightButtonDown">

                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="OpenWorkshopMenuItem"
                      Header="Открыть в Steam Workshop"
                      Click="OpenWorkshop_Click"/>

                        <Separator/>

                        <MenuItem Header="Открыть папку мода"
                      Click="OpenModFolder_Click"/>

                        <MenuItem Header="Копировать Package ID"
                      Click="CopyPackageId_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#303641"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="10"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Название"
                            Binding="{Binding Name}"
                            Width="2*"/>

                    <DataGridTextColumn Header="Package ID"
                            Binding="{Binding PackageId}"
                            Width="2*"/>

                    <DataGridTextColumn Header="Версия"
                            Binding="{Binding Version}"
                            Width="*"/>

                    <DataGridTextColumn Header="Источник"
                            Binding="{Binding Source}"
                            Width="*"/>
                </DataGrid.Columns>
            </DataGrid>


            <!-- Панель информации -->
            <Border Grid.Column="1"
            Background="#22252D"
            Margin="12,0,0,0"
            Padding="15"
            CornerRadius="6">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="ИНФОРМАЦИЯ О МОДЕ"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,0,0,15"/>

                        <Border Background="#303641"
                        Height="190"
                        CornerRadius="5"
                        ClipToBounds="True">

                            <Image x:Name="ModPreview"
                           Stretch="Uniform"/>
                        </Border>

                        <TextBlock x:Name="ModName"
                           Text="Выберите модификацию"
                           FontSize="18"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           Margin="0,15,0,10"/>

                        <TextBlock Text="Package ID"
                           Foreground="#9099A8"
                           FontSize="12"/>

                        <TextBlock x:Name="ModPackageId"
                           Text="—"
                           TextWrapping="Wrap"
                           Margin="0,3,0,12"/>

                        <TextBlock Text="Версия"
                           Foreground="#9099A8"
                           FontSize="12"/>

                        <TextBlock x:Name="ModVersion"
                           Text="—"
                           Margin="0,3,0,12"/>

                        <TextBlock Text="Источник"
                           Foreground="#9099A8"
                           FontSize="12"/>

                        <TextBlock x:Name="ModSource"
                           Text="—"
                           Margin="0,3,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Запуск игры -->
        <Button Grid.Row="3"
                Content="ЗАПУСТИТЬ RIMWORLD"
                Click="Launch_Click"
                Height="50"
                Margin="0,15,0,0"
                FontWeight="Bold"/>
    </Grid>
</Window>
