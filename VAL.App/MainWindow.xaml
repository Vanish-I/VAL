<Window x:Class="VAL.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VAL Launcher"
        Height="740"
        Width="1180"
        MinHeight="600"
        MinWidth="900"
        Background="#17191D"
        Foreground="#D6D8D9"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- ═════════ Палитра ═════════ -->
        <SolidColorBrush x:Key="BgBrush"          Color="#17191D"/>
        <SolidColorBrush x:Key="SurfaceBrush"     Color="#22262C"/>
        <SolidColorBrush x:Key="SurfaceAltBrush"  Color="#272C33"/>
        <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#2E343C"/>
        <SolidColorBrush x:Key="ElevatedBrush"    Color="#30363E"/>
        <SolidColorBrush x:Key="LineBrush"        Color="#41464D"/>
        <SolidColorBrush x:Key="TextBrush"        Color="#D6D8D9"/>
        <SolidColorBrush x:Key="MutedBrush"       Color="#9299A2"/>
        <SolidColorBrush x:Key="DimBrush"         Color="#747D87"/>
        <SolidColorBrush x:Key="AccentBrush"      Color="#D58A36"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#F0A34C"/>
        <SolidColorBrush x:Key="AccentSoftBrush"  Color="#3A3027"/>
        <SolidColorBrush x:Key="AccentSoftHoverBrush" Color="#493A2B"/>
        <SolidColorBrush x:Key="OkBrush"          Color="#6FB26B"/>

        <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

        <!-- ═════════ Кнопки ═════════ -->
        <Style x:Key="VALButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ElevatedBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Главная кнопка: собственный шаблон, чтобы при наведении не серела -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource VALButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource BgBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#D58A36" BlurRadius="18"
                                                  ShadowDepth="0" Opacity="0.25"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B87429"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#B87429"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Иконка внутри кнопки -->
        <Style x:Key="ButtonIconStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- ═════════ Подсказки ═════════ -->
        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{StaticResource ElevatedBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="10,6">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═════════ Поле ввода ═════════ -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Поле поиска: иконка + подсказка, пока пусто -->
        <Style x:Key="SearchBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE721;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="13"
                                           Foreground="{StaticResource DimBrush}"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"/>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Grid.Column="1"
                                              Margin="8,0,10,0"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"/>
                                <TextBlock x:Name="Hint"
                                           Grid.Column="1"
                                           Text="Название или ID"
                                           Foreground="{StaticResource DimBrush}"
                                           VerticalAlignment="Center"
                                           Margin="12,0,10,0"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource MutedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Hint"
            Property="Visibility"
            Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═════════ ComboBox ═════════ -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftHoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd"
                                                Background="{StaticResource SurfaceBrush}"
                                                BorderBrush="{StaticResource LineBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <TextBlock Text="&#xE70D;"
                                                       FontFamily="{StaticResource IconFont}"
                                                       FontSize="9"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,12,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter Margin="12,0,32,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              TextElement.Foreground="{StaticResource TextBrush}"/>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Margin="0,4,8,10"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="4"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.45"/>
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="220">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═════════ Полосы прокрутки ═════════ -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder"
                                                        Background="{StaticResource LineBrush}"
                                                        CornerRadius="4"
                                                        Margin="2"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource AccentBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="10"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ═════════ Таблица модов ═════════ -->
        <Style x:Key="VALHeaderGripperStyle" TargetType="Thumb">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource ElevatedBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="Center">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SortArrow"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="9"
                                               Foreground="{StaticResource AccentBrush}"
                                               Margin="7,1,0,0"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                            <Thumb x:Name="PART_LeftHeaderGripper"
                                   HorizontalAlignment="Left"
                                   Style="{StaticResource VALHeaderGripperStyle}"/>
                            <Thumb x:Name="PART_RightHeaderGripper"
                                   HorizontalAlignment="Right"
                                   Style="{StaticResource VALHeaderGripperStyle}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="SortDirection" Value="Ascending">
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SortArrow" Property="Text" Value="&#xE70E;"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Descending">
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SortArrow" Property="Text" Value="&#xE70D;"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VALCenteredHeaderStyle" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- Фон строки задаёт сама таблица (чередование); здесь только состояния -->
        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BgBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ValidationErrorTemplate" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentSoftHoverBrush}"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Тексты в ячейках -->
        <Style x:Key="VALNameTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>

        <Style x:Key="VALTechnicalTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="VALCenteredTextStyle" TargetType="TextBlock" BasedOn="{StaticResource VALTechnicalTextStyle}">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>

        <Style x:Key="VALPackageIdTextStyle" TargetType="TextBlock" BasedOn="{StaticResource VALCenteredTextStyle}">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Источник как «бейдж» -->
        <Style x:Key="VALSourceTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Подписи и значения в панели информации -->
        <Style x:Key="InfoLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="InfoValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,14"/>
        </Style>

        <!-- ═════════ Переключатель активации ═════════ -->
        <Style x:Key="VALSwitchStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Background" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderBrush" Value="#535B65"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="SwitchTrack"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="11">
                            <Ellipse x:Name="SwitchThumb"
                                     Width="14" Height="14"
                                     Fill="{StaticResource TextBrush}"
                                     HorizontalAlignment="Left"
                                     Margin="3,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,3,0"/>
                                <Setter TargetName="SwitchThumb" Property="Fill" Value="{StaticResource BgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═════════ Контекстное меню ═════════ -->
        <Style x:Key="VALContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="4"
                                SnapsToDevicePixels="True">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VALMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentSoftHoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VALMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{StaticResource LineBrush}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Карточка-панель -->
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

    </Window.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═════════ Шапка ═════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="Assets/val-logo.png"
                       Width="56" Height="56"
                       Stretch="Uniform"
                       Margin="0,0,16,14"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <StackPanel VerticalAlignment="Center" Margin="0,0,0,14">
                    <TextBlock Text="VAL"
                               FontFamily="RimWordFont"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               LineHeight="34"/>
                    <TextBlock Text="Vanilla Authentic Life"
                               FontFamily="RimWordFont"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="1,1,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,0,14">
                <TextBlock Text="RimWorld Mod Manager"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Border Background="{StaticResource AccentSoftBrush}"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="11"
                        Padding="10,2"
                        Margin="12,0,0,0">
                    <TextBlock Text="Beta 1.0"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                </Border>
            </StackPanel>

            <!-- Акцентная линия под шапкой -->
            <Rectangle Grid.Row="1" Grid.ColumnSpan="2" Height="1">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#D58A36" Offset="0"/>
                        <GradientStop Color="#41464D" Offset="0.35"/>
                        <GradientStop Color="#2441464D" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <!-- ═════════ Панель инструментов ═════════ -->
        <Border Grid.Row="1"
                Style="{StaticResource PanelStyle}"
                Padding="12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Click="SelectGame_Click"
                            Style="{StaticResource VALButtonStyle}"
                            Margin="0,0,8,0"
                            ToolTip="Указать папку с игрой RimWorld">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" Style="{StaticResource ButtonIconStyle}"/>
                            <TextBlock Text="Выбрать игру" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Click="ScanMods_Click"
                            Style="{StaticResource VALButtonStyle}"
                            ToolTip="Найти установленные моды заново">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource ButtonIconStyle}"/>
                            <TextBlock Text="Сканировать моды" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#272C33"
                        BorderBrush="#41464D"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,7"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="18,0,0,0">

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="RIMWORLD"
                                   Foreground="#9299A2"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                        <TextBlock x:Name="GameVersionText"
                                   Text="—"
                                   Foreground="#D58A36"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <TextBox x:Name="SearchBox"
                         Grid.Column="2"
                         Style="{StaticResource SearchBoxStyle}"
                         Width="260"
                         Height="36"
                         Margin="0,0,10,0"
                         VerticalContentAlignment="Center"
                         TextChanged="SearchBox_TextChanged"
                         ToolTip="Поиск по названию или Package ID"/>

                <ComboBox x:Name="SourceFilter"
                          Grid.Column="3"
                          Width="140"
                          Height="36"
                          SelectedIndex="0"
                          SelectionChanged="SourceFilter_SelectionChanged">
                    <ComboBoxItem Content="Все моды"/>
                    <ComboBoxItem Content="Workshop"/>
                    <ComboBoxItem Content="Local"/>
                </ComboBox>
            </Grid>
        </Border>

        <!-- ═════════ Профиль ═════════ -->
        <Border Grid.Row="2"
        Style="{StaticResource PanelStyle}"
        Padding="16,10"
        Margin="0,0,0,12">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Название и состояние профиля -->
                <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center">

                    <Border Width="3"
                    Height="30"
                    Background="{StaticResource AccentBrush}"
                    CornerRadius="2"
                    Margin="0,0,12,0"/>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Профиль модов"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="15"
                           FontWeight="SemiBold"/>

                        <TextBlock x:Name="ActiveProfileText"
                           Text="Активная конфигурация: ———"
                           Foreground="{StaticResource DimBrush}"
                           FontSize="12"
                           Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Выбор профиля -->
                <ComboBox x:Name="ProfileSelector"
          Grid.Column="1"
          VerticalAlignment="Center"
          Margin="0,0,12,0"
          SelectionChanged="ProfileSelector_SelectionChanged"
          ToolTip="Выбрать конфигурацию модов">
                </ComboBox>
                
                

                <!-- Создание профиля -->
                <Button Grid.Column="2"
                Click="CreateProfile_Click"
                Style="{StaticResource VALButtonStyle}"
                Margin="0,0,8,0"
                ToolTip="Создать новый профиль">

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;"
                           Style="{StaticResource ButtonIconStyle}"/>
                        <TextBlock Text="Создать профиль"
                           VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                


                <!-- Управление профилями -->
                <Button Grid.Column="3"
                Style="{StaticResource VALButtonStyle}"
                Click="ManageProfiles_Click"
                ToolTip="Управление профилями">

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;"
                           Style="{StaticResource ButtonIconStyle}"/>
                        <TextBlock Text="Управление"
                           VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

            </Grid>
        </Border>

        <!-- ═════════ Основная область ═════════ -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.1*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1*" MinWidth="290"/>
            </Grid.ColumnDefinitions>

            <!-- Список модов -->
            <Border Grid.Column="0"
                    Style="{StaticResource PanelStyle}"
                    Padding="0"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="18,14,18,12">
                        <TextBlock Text="Библиотека модов"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Правый клик по моду — быстрые действия"
                                   FontSize="12"
                                   Foreground="{StaticResource DimBrush}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              x:Name="ModsGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="False"
                              Background="{StaticResource SurfaceBrush}"
                              Foreground="{StaticResource TextBrush}"
                              RowBackground="{StaticResource SurfaceBrush}"
                              AlternatingRowBackground="{StaticResource SurfaceAltBrush}"
                              GridLinesVisibility="None"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              CanUserResizeRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              BorderThickness="0"
                              HorizontalScrollBarVisibility="Disabled"
                              FocusVisualStyle="{x:Null}"
                              SelectionChanged="ModsGrid_SelectionChanged"
                              PreviewMouseRightButtonDown="ModsGrid_PreviewMouseRightButtonDown">

                        <DataGrid.ContextMenu>
                            <ContextMenu Style="{StaticResource VALContextMenuStyle}">
                                <MenuItem x:Name="OpenWorkshopMenuItem"
                                          Header="Открыть в Steam Workshop"
                                          Click="OpenWorkshop_Click"
                                          Style="{StaticResource VALMenuItemStyle}"/>
                                <Separator Style="{StaticResource VALMenuSeparatorStyle}"/>
                                <MenuItem Header="Открыть папку мода"
                                          Click="OpenModFolder_Click"
                                          Style="{StaticResource VALMenuItemStyle}"/>
                                <MenuItem Header="Копировать Package ID"
                                          Click="CopyPackageId_Click"
                                          Style="{StaticResource VALMenuItemStyle}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>

                        <DataGrid.Columns>

                            <DataGridTemplateColumn Header="Совмест."
                        Width="85"
                        IsReadOnly="True"
                        HeaderStyle="{StaticResource VALCenteredHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="11"
                     Height="11"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     StrokeThickness="1"
                     Stroke="#17191D"
                     ToolTip="Совместимость с текущей версией RimWorld">

                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#9299A2"/>

                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCompatible}"
                                         Value="True">
                                                            <Setter Property="Fill" Value="#6FB26B"/>
                                                        </DataTrigger>

                                                        <DataTrigger Binding="{Binding IsCompatible}"
                                         Value="False">
                                                            <Setter Property="Fill" Value="#D84B4B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Название"
                                                Binding="{Binding Name}"
                                                IsReadOnly="True"
                                                Width="2.2*"
                                                ElementStyle="{StaticResource VALNameTextStyle}"/>

                            <DataGridTextColumn Header="ID"
                                                Binding="{Binding PackageId}"
                                                IsReadOnly="True"
                                                Width="2*"
                                                ElementStyle="{StaticResource VALPackageIdTextStyle}"
                                                HeaderStyle="{StaticResource VALCenteredHeaderStyle}"/>

                            <DataGridTextColumn Header="Версия"
                                                Binding="{Binding Version}"
                                                IsReadOnly="True"
                                                Width="*"
                                                ElementStyle="{StaticResource VALCenteredTextStyle}"
                                                HeaderStyle="{StaticResource VALCenteredHeaderStyle}"/>

                            <DataGridTextColumn Header="Источник"
                                                Binding="{Binding Source}"
                                                IsReadOnly="True"
                                                Width="*"
                                                ElementStyle="{StaticResource VALSourceTextStyle}"
                                                HeaderStyle="{StaticResource VALCenteredHeaderStyle}"/>

                            <DataGridTemplateColumn Header="Активен"
                                                    Width="90"
                                                    IsReadOnly="False"
                                                    HeaderStyle="{StaticResource VALCenteredHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ToggleButton IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Style="{StaticResource VALSwitchStyle}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Click="ModEnabled_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Информация о моде -->
            <Border Grid.Column="2"
                    Style="{StaticResource PanelStyle}"
                    Padding="18,16,6,16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Информация"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"/>

                        <TextBlock Text="Сведения о выбранном моде"
                                   FontSize="12"
                                   Foreground="{StaticResource DimBrush}"
                                   Margin="0,3,0,14"/>

                        <Border Background="{StaticResource BgBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                Height="190"
                                CornerRadius="6"
                                ClipToBounds="True">
                            <Grid>
                                <!-- Заглушка, пока нет превью -->
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Opacity="0.55">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Source, ElementName=ModPreview}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="&#xEB9F;"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="36"
                                               Foreground="{StaticResource LineBrush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Нет превью"
                                               FontSize="12"
                                               Foreground="{StaticResource DimBrush}"
                                               Margin="0,8,0,0"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>

                                <Image x:Name="ModPreview"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                        </Border>

                        <StackPanel Margin="0,12,0,0">

                            <TextBlock Text="ПОДДЕРЖИВАЕМЫЕ ВЕРСИИ RIMWORLD"
               FontSize="10"
               FontWeight="SemiBold"
               Foreground="{StaticResource DimBrush}"/>

                            <TextBlock x:Name="ModSupportedVersions"
               Text="—"
               FontSize="13"
               Foreground="{StaticResource TextBrush}"
               Margin="0,5,0,0"
               TextWrapping="Wrap"/>

                        </StackPanel>

                        <TextBlock x:Name="ModName"
                                   Text="Выберите мод в списке"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,16,0,16"/>

                        <TextBlock Text="ID" Style="{StaticResource InfoLabelStyle}"/>
                        <TextBlock x:Name="ModPackageId"
                                   Text="—"
                                   FontFamily="Consolas"
                                   Style="{StaticResource InfoValueStyle}"/>

                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,0,0,12"/>

                        <TextBlock Text="Версия" Style="{StaticResource InfoLabelStyle}"/>
                        <TextBlock x:Name="ModVersion"
                                   Text="—"
                                   Style="{StaticResource InfoValueStyle}"/>

                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,0,0,12"/>

                        <TextBlock Text="Источник" Style="{StaticResource InfoLabelStyle}"/>
                        <TextBlock x:Name="ModSource"
                                   Text="—"
                                   Style="{StaticResource InfoValueStyle}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ═════════ Нижняя панель запуска ═════════ -->
        <Border Grid.Row="4"
                Style="{StaticResource PanelStyle}"
                Padding="16,12"
                Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="9" Height="9"
                             Fill="{StaticResource OkBrush}"
                             VerticalAlignment="Center"
                             Margin="0,1,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Vanilla Authentic Life"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="StatusText"
                                   Text="Подготовка к запуску"
                                   Foreground="{StaticResource DimBrush}"
                                   FontSize="12"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1"
                        Click="Launch_Click"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="48"
                        Width="240"
                        Padding="20,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" Style="{StaticResource ButtonIconStyle}" FontSize="15"/>
                        <TextBlock Text="Запустить RimWorld" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
