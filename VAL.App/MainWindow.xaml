<Window x:Class="VAL.App.MainWindow"
        FontFamily="Microsoft Sans Serif"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VAL Launcher"
        Height="700"
        Width="1120"
        MinHeight="550"
        MinWidth="850"
        Background="#17191D"
        Foreground="#D6D8D9"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- Основные цвета и стили -->

        <Style x:Key="VALButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#30363E"/>
            <Setter Property="Foreground" Value="#D6D8D9"/>
            <Setter Property="BorderBrush" Value="#41464D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#3B434D"/>
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#D58A36"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#252A30"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource VALButtonStyle}">
            <Setter Property="Background" Value="#D58A36"/>
            <Setter Property="Foreground" Value="#17191D"/>
            <Setter Property="BorderBrush" Value="#D58A36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#22262C"/>
            <Setter Property="Foreground" Value="#D6D8D9"/>
            <Setter Property="BorderBrush" Value="#41464D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#D58A36"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#22262C"/>
            <Setter Property="Foreground" Value="#D6D8D9"/>
            <Setter Property="BorderBrush" Value="#41464D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder"
                            Background="#22262C"
                            BorderBrush="#41464D"
                            BorderThickness="1"
                            CornerRadius="5"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter Grid.Column="0"
                                          Margin="10,0,0,0"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          TextElement.Foreground="#D6D8D9"/>

                                <ToggleButton Grid.Column="1"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Content="⌄"
                                      Foreground="#D58A36"/>
                            </Grid>

                            <Popup x:Name="PART_Popup"
                           Placement="Bottom"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           AllowsTransparency="True"
                           Focusable="False"
                           PopupAnimation="Fade">
                                <Border Background="#22262C"
                                BorderBrush="#41464D"
                                BorderThickness="1"
                                CornerRadius="5"
                                MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="200">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder"
                                Property="BorderBrush"
                                Value="#D58A36"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#30363E"/>
            <Setter Property="Foreground" Value="#9299A2"/>
            <Setter Property="BorderBrush" Value="#41464D"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="12,11"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#22262C"/>
            <Setter Property="Foreground" Value="#D6D8D9"/>
            <Setter Property="BorderBrush" Value="#30363E"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Height" Value="46"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#30363E"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#493A2B"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Контекстное меню -->
        <Style x:Key="VALContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="#22262C"/>
            <Setter Property="Foreground" Value="#D6D8D9"/>
            <Setter Property="BorderBrush" Value="#41464D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#22262C"
                        BorderBrush="#41464D"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="5"
                        SnapsToDevicePixels="True">
                            <StackPanel IsItemsHost="True"
                                KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Пункты контекстного меню -->
        <Style x:Key="VALMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D6D8D9"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="4"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                      RecognizesAccessKey="True"
                                      VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder"
                                Property="Background"
                                Value="#493A2B"/>
                                <Setter Property="Foreground"
                                Value="#D58A36"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Разделители -->
        <Style x:Key="VALMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="5,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1"
                        Background="#41464D"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- VAL ScrollBar Style -->
<Style TargetType="{x:Type ScrollBar}">
    <Setter Property="Width" Value="12"/>
    <Setter Property="Background" Value="#17191D"/>
    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="{x:Type ScrollBar}">
                <Grid Background="{TemplateBinding Background}">
                    <Track x:Name="PART_Track"
                           IsDirectionReversed="True">

                        <Track.DecreaseRepeatButton>
                            <RepeatButton
                                Command="ScrollBar.PageUpCommand"
                                Opacity="0"
                                Focusable="False"/>
                        </Track.DecreaseRepeatButton>

                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border x:Name="ThumbBorder"
                                                Background="#41464D"
                                                CornerRadius="5"
                                                Margin="2,1"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver"
                                                     Value="True">
                                                <Setter TargetName="ThumbBorder"
                                                        Property="Background"
                                                        Value="#D58A36"/>
                                            </Trigger>
                                            <Trigger Property="IsDragging"
                                                     Value="True">
                                                <Setter TargetName="ThumbBorder"
                                                        Property="Background"
                                                        Value="#F0A34C"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>

                        <Track.IncreaseRepeatButton>
                            <RepeatButton
                                Command="ScrollBar.PageDownCommand"
                                Opacity="0"
                                Focusable="False"/>
                        </Track.IncreaseRepeatButton>

                    </Track>
                </Grid>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>

        <!-- Основной текст таблицы -->
        <Style x:Key="VALGridTextStyle"
       TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#D6D8D9"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- Package ID -->
        <Style x:Key="VALPackageTextStyle"
       TargetType="TextBlock"
       BasedOn="{StaticResource VALGridTextStyle}">
            <Setter Property="Foreground" Value="#9299A2"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- Источник -->
        <Style x:Key="VALSourceTextStyle"
       TargetType="TextBlock"
       BasedOn="{StaticResource VALGridTextStyle}">
            <Setter Property="Foreground" Value="#D58A36"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->

        <Grid Grid.Row="0" Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal"
            VerticalAlignment="Center">

                <Image Source="Assets/val-logo.png"
       Width="64"
       Height="64"
       Stretch="Uniform"
       Margin="0,0,14,0"/>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="VAL"
           FontFamily="RimWordFont"
           FontSize="30"
           FontWeight="Bold"
           Foreground="#D58A36"/>

                    <TextBlock Text="VANILLA AUTHENTIC LIFE"
                   FontFamily="RimWordFont"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="#9299A2"
                   Margin="2,2,0,0"/>
                </StackPanel>

            </StackPanel>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right">
                <TextBlock Text="RimWorld Mod Manager"
                           Foreground="#9299A2"
                           FontSize="18"
                           FontWeight="Bold"
                           HorizontalAlignment="Right"/>

                <TextBlock Text="BETA 0.4"
                           Foreground="#D58A36"
                           FontSize="15"
                           HorizontalAlignment="Right"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Панель инструментов -->

        <Border Grid.Row="1"
                Background="#22262C"
                BorderBrush="#41464D"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,14">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal">
                    <Button Content="ВЫБРАТЬ ИГРУ"
                            Click="SelectGame_Click"
                            Style="{StaticResource VALButtonStyle}"
                            Margin="0,0,8,0"/>

                    <Button Content="СКАНИРОВАТЬ МОДЫ"
                            Click="ScanMods_Click"
                            Style="{StaticResource VALButtonStyle}"/>
                </StackPanel>

                <TextBox x:Name="SearchBox"
                         Grid.Column="2"
                         Width="230"
                         Height="36"
                         Margin="0,0,10,0"
                         VerticalContentAlignment="Center"
                         TextChanged="SearchBox_TextChanged"
                         ToolTip="Поиск по названию или Package ID">
                </TextBox>

                <ComboBox x:Name="SourceFilter"
                          Grid.Column="3"
                          Width="125"
                          Height="36"
                          HorizontalAlignment="Right"
                          SelectedIndex="0"
                          SelectionChanged="SourceFilter_SelectionChanged">
                    <ComboBoxItem Content="Все моды"/>
                    <ComboBoxItem Content="Workshop"/>
                    <ComboBoxItem Content="Local"/>
                </ComboBox>
            </Grid>
        </Border>

        <!-- Основная рабочая область -->

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.1*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Список модов -->

            <Border Grid.Column="0"
                    Background="#22262C"
                    BorderBrush="#41464D"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="2,0,0,12">
                        <TextBlock Text="БИБЛИОТЕКА МОДОВ"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#D6D8D9"/>

                        <TextBlock Text="УСТАНОВЛЕННЫЕ МОДИФИКАЦИИ"
                                   FontSize="9"
                                   Foreground="#747D87"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              x:Name="ModsGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Background="#22262C"
                              Foreground="#D6D8D9"
                              RowBackground="#22262C"
                              AlternatingRowBackground="#272C33"
                              GridLinesVisibility="None"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              CanUserResizeRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              BorderThickness="0"
                              SelectionChanged="ModsGrid_SelectionChanged"
                              PreviewMouseRightButtonDown="ModsGrid_PreviewMouseRightButtonDown">

                        <DataGrid.ContextMenu>
                            <ContextMenu Style="{StaticResource VALContextMenuStyle}">

                                <MenuItem x:Name="OpenWorkshopMenuItem"
                  Header="Открыть в Steam Workshop"
                  Click="OpenWorkshop_Click"
                  Style="{StaticResource VALMenuItemStyle}"/>

                                <Separator Style="{StaticResource VALMenuSeparatorStyle}"/>

                                <MenuItem Header="Открыть папку мода"
                  Click="OpenModFolder_Click"
                  Style="{StaticResource VALMenuItemStyle}"/>

                                <MenuItem Header="Копировать Package ID"
                  Click="CopyPackageId_Click"
                  Style="{StaticResource VALMenuItemStyle}"/>

                            </ContextMenu>
                        </DataGrid.ContextMenu>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="НАЗВАНИЕ"
                    Binding="{Binding Name}"
                    Width="2*"
                    ElementStyle="{StaticResource VALGridTextStyle}"/>

                            <DataGridTextColumn Header="PACKAGE ID"
                    Binding="{Binding PackageId}"
                    Width="2*"
                    ElementStyle="{StaticResource VALPackageTextStyle}"/>

                            <DataGridTextColumn Header="ВЕРСИЯ"
                    Binding="{Binding Version}"
                    Width="*"
                    ElementStyle="{StaticResource VALGridTextStyle}"/>

                            <DataGridTextColumn Header="ИСТОЧНИК"
                    Binding="{Binding Source}"
                    Width="*"
                    ElementStyle="{StaticResource VALSourceTextStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Разделитель -->

            <Border Grid.Column="1"
                    Background="#17191D"/>

            <!-- Информация о моде -->

            <Border Grid.Column="2"
                    Background="#22262C"
                    BorderBrush="#41464D"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="ИНФОРМАЦИЯ"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#D6D8D9"/>

                        <TextBlock Text="СВЕДЕНИЯ О ВЫБРАННОМ МОДЕ"
                                   FontSize="9"
                                   Foreground="#747D87"
                                   Margin="0,4,0,14"/>

                        <Border Background="#17191D"
                                BorderBrush="#41464D"
                                BorderThickness="1"
                                Height="190"
                                CornerRadius="5"
                                ClipToBounds="True">

                            <Image x:Name="ModPreview"
                                   Stretch="Uniform"/>
                        </Border>

                        <TextBlock x:Name="ModName"
                                   Text="Выберите модификацию"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="#D6D8D9"
                                   TextWrapping="Wrap"
                                   Margin="0,16,0,18"/>

                        <TextBlock Text="PACKAGE ID"
                                   Foreground="#9299A2"
                                   FontSize="10"
                                   FontWeight="Bold"/>

                        <TextBlock x:Name="ModPackageId"
                                   Text="—"
                                   Foreground="#D6D8D9"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,15"/>

                        <Border Height="1"
                                Background="#41464D"
                                Margin="0,0,0,13"/>

                        <TextBlock Text="ВЕРСИЯ"
                                   Foreground="#9299A2"
                                   FontSize="10"
                                   FontWeight="Bold"/>

                        <TextBlock x:Name="ModVersion"
                                   Text="—"
                                   Foreground="#D6D8D9"
                                   Margin="0,5,0,15"/>

                        <Border Height="1"
                                Background="#41464D"
                                Margin="0,0,0,13"/>

                        <TextBlock Text="ИСТОЧНИК"
                                   Foreground="#9299A2"
                                   FontSize="10"
                                   FontWeight="Bold"/>

                        <TextBlock x:Name="ModSource"
                                   Text="—"
                                   Foreground="#D6D8D9"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Нижняя панель запуска -->

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="VANILLA AUTHENTIC LIFE"
                           Foreground="#9299A2"
                           FontSize="12"
                           FontWeight="Bold"/>

                <TextBlock Text="Подготовка к запуску"
                           Foreground="#747D87"
                           FontSize="13"
                           Margin="0,3,0,0"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="ЗАПУСТИТЬ RIMWORLD"
                    Click="Launch_Click"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Height="48"
                    Width="230"
                    Padding="20,10"/>
        </Grid>
    </Grid>
</Window>